{
  "rule": "canonicalLegacyUuid (UltiCloud backend schema decision 22): trim surrounding whitespace; if longer than 36 characters and the first 36 form a standard hyphenated UUID, keep those 36; remove every '-'; lower-case; return only exactly 32 hex digits, otherwise null.",
  "provenance": "Provisional framework copy written from the decision text (Phase 22 plan 22-01, S-41). Plan 22-08 replaces this file with the backend's own legacy-uuid-canonicalization.json fixture.",
  "cases": [
    { "name": "32 lower-case hex digits are kept", "input": "0123456789abcdef0123456789abcdef", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "upper-case hex is lower-cased", "input": "0123456789ABCDEF0123456789ABCDEF", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "a hyphenated UUID loses its hyphens", "input": "01234567-89ab-cdef-0123-456789abcdef", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "an upper-case hyphenated UUID", "input": "01234567-89AB-CDEF-0123-456789ABCDEF", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "surrounding spaces are trimmed", "input": "  01234567-89ab-cdef-0123-456789abcdef  ", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "a trailing newline is trimmed", "input": "0123456789abcdef0123456789abcdef\n", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "a hyphenated UUID with a trailing newline", "input": "01234567-89ab-cdef-0123-456789abcdef\n", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "a hyphenated UUID followed by one extra character (six profiled legacy rows)", "input": "01234567-89ab-cdef-0123-456789abcdefx", "expected": "0123456789abcdef0123456789abcdef" },
    { "name": "13 hex digits (the profiled short row)", "input": "0123456789abc", "expected": null },
    { "name": "33 hex digits without hyphens", "input": "0123456789abcdef0123456789abcdef0", "expected": null },
    { "name": "a UUID with a non-hex digit", "input": "0123456g-89ab-cdef-0123-456789abcdef", "expected": null },
    { "name": "32 characters with a non-ASCII digit", "input": "0123456789abcdef0123456789abcde０", "expected": null },
    { "name": "an empty string", "input": "", "expected": null },
    { "name": "null", "input": null, "expected": null }
  ]
}
