{
  "$comment": "Golden cases for canonicalLegacyUuid (packages/contracts/src/agent-rest/legacy-uuid.ts). The framework (Java) and the backend (TS: ETL and API) must both pass every case. Inputs are synthetic; none is a real server UUID.",
  "rule": [
    "1. Not a string (null) -> null.",
    "2. Strip leading and trailing characters U+0000..U+0020 (exactly Java String.trim(); other Unicode whitespace such as U+00A0 is not stripped).",
    "3. If the result is longer than 36 characters and its first 36 characters are a hyphenated UUID (8-4-4-4-12 hex digits, either case), keep only those 36 characters.",
    "4. Remove every '-'.",
    "5. Lower-case ASCII A-F.",
    "6. The result must be exactly 32 characters [0-9a-f]; otherwise -> null (the owner re-attaches the server by hand in the panel)."
  ],
  "cases": [
    {
      "name": "hyphenated-lower",
      "input": "123e4567-e89b-12d3-a456-426614174000",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "hyphenated-upper",
      "input": "123E4567-E89B-12D3-A456-426614174000",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "hyphenated-mixed-case",
      "input": "123E4567-e89B-12d3-A456-426614174000",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "compact-lower",
      "input": "123e4567e89b12d3a456426614174000",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "compact-upper",
      "input": "123E4567E89B12D3A456426614174000",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "surrounding-spaces",
      "input": "  123e4567-e89b-12d3-a456-426614174000  ",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "trailing-newline",
      "input": "123e4567-e89b-12d3-a456-426614174000\n",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
      "name": "tab-and-crlf",
      "input": "\t123e4567e89b12d3a456426614174000\r\n",
      "expected": "123e4567e89b12d3a456426614174000"
    },
    {
