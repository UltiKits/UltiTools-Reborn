{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/op.progress.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "op.progress"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "replyTo": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "done",
        "total"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "replyTo",
    "payload"
  ],
  "additionalProperties": false
}
