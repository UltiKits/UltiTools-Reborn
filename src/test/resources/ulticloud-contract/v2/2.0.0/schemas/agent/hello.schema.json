{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/hello.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "hello"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "payload": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "protocol": {
          "type": "number",
          "const": 2
        },
        "capabilities": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9][a-z0-9.-]*)?(@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "powerActionsEnabled": {
              "type": "boolean"
            }
          },
          "required": [
            "powerActionsEnabled"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "framework",
        "protocol",
        "capabilities",
        "settings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
