{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/welcome.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "welcome"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "replyTo": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "number",
          "const": 2
        },
        "serverId": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "accepted": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9-]*(:[a-z0-9][a-z0-9.-]*)?(@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxFrameBytes": {
              "type": "integer",
              "minimum": 65536,
              "maximum": 1048576
            },
            "log": {
              "type": "object",
              "properties": {
                "ratePerSec": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "burst": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "lineMaxBytes": {
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 8192
                },
                "batchMaxLines": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "ratePerSec",
                "burst",
                "lineMaxBytes",
                "batchMaxLines"
              ],
              "additionalProperties": false
            },
            "outboxMax": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "commandDedupeMax": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "commandDedupeTtlSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "commandOutputMaxBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65536
            },
            "fileMaxBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 393216
            }
          },
          "required": [
            "maxFrameBytes",
            "log",
            "outboxMax",
            "commandDedupeMax",
            "commandDedupeTtlSeconds",
            "commandOutputMaxBytes",
            "fileMaxBytes"
          ],
          "additionalProperties": false
        },
        "serverTime": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        }
      },
      "required": [
        "protocol",
        "serverId",
        "accepted",
        "limits",
        "serverTime"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "replyTo",
    "payload"
  ],
  "additionalProperties": false
}
