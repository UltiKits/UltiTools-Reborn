{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/properties.get.result.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "properties.get.result"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "replyTo": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "data": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "object",
                  "properties": {
                    "motd": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "max-players": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "difficulty": {
                      "type": "string",
                      "enum": [
                        "peaceful",
                        "easy",
                        "normal",
                        "hard"
                      ]
                    },
                    "gamemode": {
                      "type": "string",
                      "enum": [
                        "survival",
                        "creative",
                        "adventure",
                        "spectator"
                      ]
                    },
                    "spawn-protection": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2147483647
                    },
                    "view-distance": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 32
                    },
                    "simulation-distance": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 32
                    },
                    "pvp": {
                      "type": "boolean"
                    },
                    "allow-flight": {
                      "type": "boolean"
                    },
                    "spawn-monsters": {
                      "type": "boolean"
                    },
                    "allow-nether": {
                      "type": "boolean"
                    },
                    "enable-command-block": {
                      "type": "boolean"
                    },
                    "online-mode": {
                      "type": "boolean"
                    },
                    "white-list": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "writable": {
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "motd",
                      "max-players",
                      "difficulty",
                      "gamemode",
                      "spawn-protection",
                      "view-distance",
                      "simulation-distance",
                      "pvp",
                      "allow-flight",
                      "spawn-monsters",
                      "allow-nether",
                      "enable-command-block"
                    ]
                  }
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "values",
                "writable",
                "version"
              ],
              "additionalProperties": false
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "not_found",
                "file_not_editable",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "status",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "replyTo",
    "payload"
  ],
  "additionalProperties": false
}
