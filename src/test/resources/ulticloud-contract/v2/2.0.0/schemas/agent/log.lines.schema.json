{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/log.lines.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "log.lines"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "payload": {
      "type": "object",
      "properties": {
        "lines": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8640000000000000
              },
              "level": {
                "type": "string",
                "enum": [
                  "DEBUG",
                  "INFO",
                  "WARN",
                  "ERROR"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "ts",
              "level",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
