{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/module.request.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "module.request"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "payload": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}$"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "additionalProperties": {}
        },
        "actor": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minecraftUuid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "userId",
            "minecraftUuid"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "module",
        "action",
        "params",
        "actor"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
