{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent/module.response.schema.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "type": {
      "type": "string",
      "const": "module.response"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "replyTo": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "ok"
            },
            "data": {},
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "status",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "module_not_found",
                "module_error",
                "deadline_exceeded",
                "internal_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 500
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "status",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "replyTo",
    "payload"
  ],
  "additionalProperties": false
}
