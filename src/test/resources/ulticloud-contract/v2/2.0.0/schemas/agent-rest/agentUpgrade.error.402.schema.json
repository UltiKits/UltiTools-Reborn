{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent-rest/agentUpgrade.error.402.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "plan_limit"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "details": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "const": "pro_expired_over_limit"
            },
            "graceEndedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "manageUrl": {
              "type": "string",
              "pattern": "^https:\\/\\/[^\\u0000- \\u007F]{1,500}$"
            }
          },
          "required": [
            "reason",
            "graceEndedAt",
            "manageUrl"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
