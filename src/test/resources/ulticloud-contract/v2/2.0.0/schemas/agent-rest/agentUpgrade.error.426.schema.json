{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent-rest/agentUpgrade.error.426.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "upgrade_required"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "details": {
          "type": "object",
          "properties": {
            "supportedProtocols": {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              }
            },
            "minFramework": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
            }
          },
          "required": [
            "supportedProtocols",
            "minFramework"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
