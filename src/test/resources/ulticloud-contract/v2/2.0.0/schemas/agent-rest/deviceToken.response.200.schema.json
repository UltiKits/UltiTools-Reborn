{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent-rest/deviceToken.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "server"
            },
            "credential": {
              "type": "string",
              "pattern": "^ucs_[A-Za-z0-9_-]{43}$"
            },
            "credentialId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "serverId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "userId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "serverName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "kind",
            "credential",
            "credentialId",
            "serverId",
            "userId",
            "serverName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cli"
            },
            "credential": {
              "type": "string",
              "pattern": "^ucc_[A-Za-z0-9_-]{43}$"
            },
            "credentialId": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "userId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "credential",
            "credentialId",
            "userId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false
}
