{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/agent-rest/deviceAuthorize.error.429.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "rate_limited"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "details": {
          "type": "object",
          "properties": {
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "retryAfterSeconds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
