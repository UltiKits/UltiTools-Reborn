{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/command_result.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "command_result"
    },
    "stream": {
      "type": "string",
      "const": "commands"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "success": {
      "type": "boolean"
    },
    "output": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    }
  },
  "required": [
    "type",
    "stream",
    "commandId",
    "success",
    "output"
  ],
  "additionalProperties": false
}
