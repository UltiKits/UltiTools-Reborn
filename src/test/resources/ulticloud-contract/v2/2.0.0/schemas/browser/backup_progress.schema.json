{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/backup_progress.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "backup_progress"
    },
    "stream": {
      "type": "string",
      "const": "commands"
    },
    "backup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "sizeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "completed",
            "failed"
          ]
        },
        "progressPercent": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "fileName",
        "createdAt",
        "sizeBytes",
        "status",
        "progressPercent",
        "error"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "stream",
    "backup"
  ],
  "additionalProperties": false
}
