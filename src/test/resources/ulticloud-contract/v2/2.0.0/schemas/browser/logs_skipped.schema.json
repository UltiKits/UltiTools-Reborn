{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/logs_skipped.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "logs_skipped"
    },
    "stream": {
      "type": "string",
      "const": "logs"
    },
    "fromSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "type",
    "stream",
    "fromSeq",
    "toSeq",
    "count"
  ],
  "additionalProperties": false
}
