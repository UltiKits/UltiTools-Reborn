{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/log.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "log"
    },
    "stream": {
      "type": "string",
      "const": "logs"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lines": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          },
          "level": {
            "type": "string",
            "enum": [
              "DEBUG",
              "INFO",
              "WARN",
              "ERROR",
              "CMD"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 8192
          },
          "commandId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "required": [
          "seq",
          "at",
          "level",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "type",
    "stream",
    "seq",
    "lines"
  ],
  "additionalProperties": false
}
