{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/subscribe.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "subscribe"
    },
    "streams": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        },
        "events": {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "commands": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "streams"
  ],
  "additionalProperties": false
}
