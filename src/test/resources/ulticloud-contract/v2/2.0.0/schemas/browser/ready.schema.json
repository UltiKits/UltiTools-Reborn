{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/ready.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "ready"
    },
    "serverId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "subscribed": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "logs",
          "events",
          "status",
          "commands"
        ]
      }
    },
    "resumedFrom": {
      "type": "object",
      "properties": {
        "logs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "serverId",
    "subscribed",
    "resumedFrom"
  ],
  "additionalProperties": false
}
