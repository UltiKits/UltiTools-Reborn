{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/command_status.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "command_status"
    },
    "stream": {
      "type": "string",
      "const": "commands"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "delivered",
        "acked",
        "succeeded",
        "failed",
        "expired",
        "cancelled"
      ]
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": [
    "type",
    "stream",
    "commandId",
    "status",
    "at"
  ],
  "additionalProperties": false
}
