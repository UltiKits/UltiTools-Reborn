{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/protocol/v2/2.0.0/browser/player_event.schema.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "player_event"
    },
    "stream": {
      "type": "string",
      "const": "events"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "event": {
      "type": "string",
      "enum": [
        "join",
        "quit"
      ]
    },
    "playerName": {
      "type": "string",
      "pattern": "^[^\\u0000- \\u007F]{1,32}$"
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  },
  "required": [
    "type",
    "stream",
    "seq",
    "event",
    "playerName",
    "at"
  ],
  "additionalProperties": false
}
