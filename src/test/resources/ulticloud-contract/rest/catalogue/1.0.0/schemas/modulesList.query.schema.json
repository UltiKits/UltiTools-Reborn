{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/modulesList.query.schema.json",
  "type": "object",
  "properties": {
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pageSize": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "q": {
      "type": "string",
      "maxLength": 100
    },
    "category": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "sort": {
      "default": "popular",
      "type": "string",
      "enum": [
        "popular",
        "newest",
        "updated",
        "name"
      ]
    }
  },
  "additionalProperties": false
}
