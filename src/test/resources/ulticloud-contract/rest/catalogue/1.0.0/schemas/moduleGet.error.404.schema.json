{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/moduleGet.error.404.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "not_found"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 64
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
