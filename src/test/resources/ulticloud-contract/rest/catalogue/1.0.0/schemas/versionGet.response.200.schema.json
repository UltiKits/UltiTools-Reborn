{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/versionGet.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/ModuleVersion"
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "ModuleVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "isLatest": {
          "type": "boolean"
        },
        "publishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changelog": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "apiLevel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "download": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "public"
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "license_required"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "withdrawn"
                },
                "withdrawnAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              },
              "required": [
                "kind",
                "withdrawnAt"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "isLatest",
        "publishedAt",
        "sizeBytes",
        "sha256",
        "changelog",
        "apiLevel",
        "download"
      ],
      "additionalProperties": false
    }
  }
}
