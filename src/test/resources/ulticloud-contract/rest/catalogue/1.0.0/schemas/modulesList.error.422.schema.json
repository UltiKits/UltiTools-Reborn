{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/modulesList.error.422.schema.json",
  "type": "object",
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "validation_failed"
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "details": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "additionalProperties": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "required": [
                "fields"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "requestId",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
