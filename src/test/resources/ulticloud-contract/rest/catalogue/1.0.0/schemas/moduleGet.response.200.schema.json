{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/moduleGet.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/CatalogueModule"
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "CatalogueModule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 200
        },
        "iconUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "downloads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latestVersion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 50000
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "compatibleApiVersions": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "developer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1F\\x7F-\\x9F\\u00AD\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u206F\\uFEFF]+$"
            },
            "avatarInitial": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "likes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "versionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "commentCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModuleVersion"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewer": {
          "type": "object",
          "properties": {
            "liked": {
              "type": "boolean"
            }
          },
          "required": [
            "liked"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "identifier",
        "shortDescription",
        "iconUrl",
        "category",
        "downloads",
        "latestVersion",
        "updatedAt",
        "description",
        "publishedAt",
        "compatibleApiVersions",
        "tags",
        "developer",
        "likes",
        "versionCount",
        "commentCount",
        "latest"
      ],
      "additionalProperties": false
    },
    "ModuleVersion": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "isLatest": {
          "type": "boolean"
        },
        "publishedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "sizeBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changelog": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "apiLevel": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "download": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "public"
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "license_required"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "withdrawn"
                },
                "withdrawnAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
                }
              },
              "required": [
                "kind",
                "withdrawnAt"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "isLatest",
        "publishedAt",
        "sizeBytes",
        "sha256",
        "changelog",
        "apiLevel",
        "download"
      ],
      "additionalProperties": false
    }
  }
}
