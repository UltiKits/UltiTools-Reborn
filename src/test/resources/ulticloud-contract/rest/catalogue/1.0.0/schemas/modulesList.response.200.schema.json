{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ultikits.com/rest/v1/catalogue/1.0.0/modulesList.response.200.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "items": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleCard"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "pageSize"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "ModuleCard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 200
        },
        "iconUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\x00-\\x20\\x7F-\\x9F/?#]+([/?#][^\\x00-\\x20\\x7F-\\x9F]*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "downloads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latestVersion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      },
      "required": [
        "id",
        "name",
        "identifier",
        "shortDescription",
        "iconUrl",
        "category",
        "downloads",
        "latestVersion",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
